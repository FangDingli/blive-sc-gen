{
  "name": "blive-sc-gen",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --build && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --build",
    "typecheck:fast": "tsrs --noEmit --fast",
    "format": "oxfmt src/",
    "lint": "oxlint src/"
  },
  "dependencies": {
    "@lucide/vue": "^1.69.0",
    "@tailwindcss/vite": "^4.3.4",
    "@vueuse/core": "^15.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "html2canvas-pro": "^2.6.3",
    "modern-screenshot": "^4.7.0",
    "reka-ui": "^2.11.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.4",
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "oxfmt": "^0.76.0",
    "oxlint": "~1.91.0",
    "tsrs": "^0.22.0-ts7.1.0-beta",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.6",
    "vue-tsc": "^3.3.14"
  },
  "engines": {
    "node": ">=22"
  },
  "allowScripts": {
    "reka-ui": true,
    "cn": true,
    "@vueuse/core": true,
    "@lucide/vue": true,
    "esbuild": true,
    "vue-demi": true,
    "oxlint": true,
    "vite-plus": true,
    "tsrs": true,
    "workerd": true,
    "unrs-resolver": true,
    "@tailwindcss/oxide": true
  }
}
